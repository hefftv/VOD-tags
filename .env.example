# Used by Docker Compose and Podman Compose (auto-loaded from this file).
# Copy to .env and adjust as needed: cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Twitch Helix API
TWITCH_CLIENT_ID=
TWITCH_SECRET_ID=

# Optional ML server (leave blank to run UI without highlights)
ML_SERVER_HOST=
ML_SERVER_PORT=5555
