# Used by Docker Compose and Podman Compose (auto-loaded from this file).
# Copy to .env and adjust as needed: cp .env.example .env

# --- Deployment mode ---
# gcp   = original behavior (gsutil -> public GCS bucket) [server default]
# local = shared volume + nginx clips service (docker compose --profile full)
CLIP_STORAGE_BACKEND=gcp

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Twitch Helix API (web app stream lookup + stream recorder)
TWITCH_CLIENT_ID=
TWITCH_SECRET_ID=

# ML server connection (web app -> ml-server)
# GCP: set to ML server public IP. Local full stack: ml-server
ML_SERVER_HOST=
ML_SERVER_PORT=5555

# --- GCP (original server/config.py fields) ---
GCS_BUCKET_NAME=YOUR-GOOGLE-CLOUD-STORAGE-BUCKET-NAME
WEBAPP_PUBLIC_IP=34.122.9.136
WEBAPP_PUBLIC_PORT=5555
# Mount a service account JSON and set GOOGLE_APPLICATION_CREDENTIALS for gsutil in containers

# --- Local / Docker full stack (--profile full) ---
# CLIP_STORAGE_BACKEND=local
# ML_SERVER_HOST=ml-server
# WEBAPP_HOST=web
# WEBAPP_PORT=8000
# CLIP_PUBLIC_BASE_URL=http://localhost:8080
TWITCH_CHAT_NICKNAME=
TWITCH_OAUTH_TOKEN=
